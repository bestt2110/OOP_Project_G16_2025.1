+package TestBaBai;
+
+import javafx.application.Application;
+import javafx.collections.FXCollections;
+import javafx.collections.ObservableList;
+import javafx.scene.Scene;
+import javafx.scene.chart.PieChart;
+import javafx.stage.Stage;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import Model.*;
+import PreProcessor.*;
+import Data.*;
+
+public class TestEx2 extends Application {
+
+    // Lưu kết quả đếm loại thiên tai
+    private static Map<String, Integer> damageTypeCount;
+
+    // ============================================
+    // 1. HÀM PHÂN LOẠI THIÊN TAI (TÙY BẠN ĐỊNH NGHĨA)
+    // ============================================
+    // Trả về label như: "bão", "lụt", "động đất", "sạt lở", ...
+    public static String getDamageTypeLabel(String sentence) {
+
+        if (sentence == null) return "khác";
+
+        // Ví dụ rule-based đơn giản (bạn thay bằng AI hay regex tùy ý)
+        if (sentence.contains("bão")) return "Bão";
+        if (sentence.contains("lụt") || sentence.contains("ngập")) return "Lũ lụt";
+        if (sentence.contains("động đất")) return "Động đất";
+        if (sentence.contains("cháy") || sentence.contains("hỏa hoạn")) return "Cháy";
+        if (sentence.contains("sạt lở")) return "Sạt lở";
+
+        return "Khác";
+    }
+
+    // ============================================
+    // 2. XỬ LÝ TẤT CẢ POST + COMMENT
+    // ============================================
+    public static class DamageAggregator {
+
+        Map<String, Integer> countMap = new HashMap<>();
+
+        public void processAll(List<Post> posts, PreProcessPipeline pipeline) {
+
+            for (Post post : posts) {
+                pipeline.execute(post);
+                add(post.getCleanContent());
+
+                for (Comment c : post.getComments()) {
+                    pipeline.execute(c);
+                    add(c.getCleanContent());
+                }
+            }
+        }
+
+        private void add(String sentence) {
+            if (sentence == null || sentence.isEmpty()) return;
+
+            String type = getDamageTypeLabel(sentence);
+            countMap.put(type, countMap.getOrDefault(type, 0) + 1);
+        }
+    }
+
+    // ============================================
+    // 3. START JAVAFX – HIỂN THỊ PIE CHART
+    // ============================================
+    @Override
+    public void start(Stage stage) {
+
+        stage.setTitle("Pie Chart – Tỷ lệ loại thiên tai");
+
+        ObservableList<PieChart.Data> pieData = FXCollections.observableArrayList();
+
+        for (String type : damageTypeCount.keySet()) {
+            pieData.add(new PieChart.Data(type, damageTypeCount.get(type)));
+        }
+
+        PieChart pieChart = new PieChart(pieData);
+        pieChart.setTitle("Thống kê loại thiên tai");
+        pieChart.setLabelsVisible(true);
+
+        Scene scene = new Scene(pieChart, 800, 600);
+        stage.setScene(scene);
+        stage.show();
+    }
+
+    // ============================================
+    // 4. MAIN – ĐỌC FILE, PREPROCESS, AGGREGATE
+    // ============================================
+    public static void main(String[] args) {
+
+        try {
+            FileCollector collector = new FileCollector();
+
+            System.out.println("Đang đọc Posts...");
+            List<Post> posts = collector.collect(
+                "C:\\Users\\admin\\Pictures\\OOP_Project_G16_2025.1\\Source code\\OOP_Prj\\youtubevideos.csv"
+            );
+            System.out.println("Đã đọc " + posts.size() + " bài viết.");
+
+            System.out.println("Đang đọc Comments...");
+            collector.loadComments(
+                "C:\\Users\\admin\\Pictures\\OOP_Project_G16_2025.1\\Source code\\OOP_Prj\\data.csv",
+                posts
+            );
+
+            // Preprocess pipeline
+            PreProcessPipeline pipeline = new PreProcessPipeline();
+            pipeline.addProcessor(new LowerCaseProcessor());
+            pipeline.addProcessor(new SpecialSymbolRemover());
+
+            // Aggregator
+            DamageAggregator aggregator = new DamageAggregator();
+            aggregator.processAll(posts, pipeline);
+
+            damageTypeCount = aggregator.countMap;
+
+            // Chạy JavaFX
+            Application.launch(TestEx2.class);
+
+        } catch (Exception e) {
+            e.printStackTrace();
+        }
+    }
+}
